+++ CLOSURE
*** Kinda recursive one
!I! 34
!C! 0
>>> 1

class Main : Object {
  run [|
    a := [ | a := 1. ] value.
    b := [ :x| a := x. ] value: 10. "a is taken as a closure"
    c := [ :x :y:z |
      c := 100. "c does not yet exists, is created"
      d := [| xx := c plus: 5. _ := (xx asString) print. ]. "c here is meant to be 100"
    ] value: 0 value: 1 value: 2.

    _ := c value. "Should print 100 + 5"

    block := [:x |
      _ := [| x := 5. ]. "Here it will error, when called, due to assigning to formal parameter"
    ] value: 15.

    e := block value. "Error: 34"
    
  ]
}