+++ ADVANCED
*** From test
!C! 0
!I! 0
>>> 1

class MyInt : Integer {
  square [
    | _ := self multiplyBy: self.
  ]
}

class Main : Object {
  run [ |
    n := MyInt new.
    n := n plus: 10.
    _ := (n asString) print.
    _ := n s: 'Hello World!'.
    x := MyInt from: n.
    _ := ((x square) asString) print.
    _ := ((x s) asString) print.
  ]
}
