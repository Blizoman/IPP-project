+++ BASIC
*** Simple block
!I! 0
!C! 0
>>> 1

class Main : Object {
  run [|
    a := [ | _ := 1. ] value. "Blok bez parametrů"
    b := [ :x|_ := x. ] value: 10. "Blok s jedním parametrem"
    c := [ :x :y:z | _ := x plus: y. ] value: 2 value: 3 value: 4. "Blok se třemi parametry"

    _ := (a asString) print.
    _ := (b asString) print.
    _ := (c asString) print.
  ]
}
