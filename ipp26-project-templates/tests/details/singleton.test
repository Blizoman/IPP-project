+++ DETAILS
*** boolean and nil are singletons
!I! 0
!C! 0
>>> 1

class Main : Object {
  print: [:x | _ := (x asString) print.]

  run [|
    "All are just singletons"
    _ := self print: (nil identicalTo: nil).
    _ := self print: (nil identicalTo: (Nil new)).
    _ := self print: (nil equalTo: nil).

    _ := self print: (true identicalTo: true).
    _ := self print: (true identicalTo: (True new)).
    _ := self print: (true equalTo: true).

    _ := self print: (false identicalTo: false).
    _ := self print: (false identicalTo: (False new)).
    _ := self print: (false equalTo: false).

    _ := self print: (false identicalTo: (true not)).
    _ := self print: (true identicalTo: (false not)).
  ]
}
