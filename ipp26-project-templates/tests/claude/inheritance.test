+++ OOP
*** Dedicnost a redefinicia metody
!C! 0
!I! 0
>>> 3

class Animal : Object {
  speak [|
    _ := 'generic sound' print.
  ]
}

class Dog : Animal {
  speak [|
    _ := 'woof' print.
  ]
}

class Main : Object {
  run [|
    a := Animal new.
    d := Dog new.
    _ := a speak.
    _ := d speak.
  ]
}
