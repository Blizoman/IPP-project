+++ CONTROL
*** Cyklus pomocou whileTrue:
!C! 0
!I! 0
>>> 3

class Main : Object {
  run [|
    _ := self counter: 3.
    _ := [| _ := (self counter) greaterThan: 0. ] whileTrue: [|
      _ := ((self counter) asString) print.
      _ := '\n' print.
      _ := self counter: ((self counter) minus: 1).
    ].
  ]
}
