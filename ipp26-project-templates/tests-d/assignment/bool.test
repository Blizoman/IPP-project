+++ BASIC
*** Boolean Short-Circuit-Evaluation
!I! 0
!C! 0
>>> 1

class Main : Object {
 run [|
      "Příklad výrazu s pravdivostními hodnotami"
    y := (true and: [| _ := false isBoolean. ]) or: [| _ := nil error. ].
      "vrací true, blok s nil error není vůbec vykonán"
    _ := (y asString) print.
 ]
}
