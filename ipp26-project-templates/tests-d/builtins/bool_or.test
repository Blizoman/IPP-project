+++ BUILTIN
*** Boolean or: with short-circuit evaluation
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := true or: [| _ := false. ].
    _ := (r1 asString) print.
    r2 := false or: [| _ := true. ].
    _ := (r2 asString) print.
    r3 := false or: [| _ := false. ].
    _ := (r3 asString) print.
    r4 := true or: [| _ := nil error. ].
    _ := (r4 asString) print.
  ]
}
