+++ BUILTIN
*** String asInteger converts a numeric string to an integer
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := '42' asInteger.
    _ := (r1 asString) print.
    r2 := '-10' asInteger.
    _ := (r2 asString) print.
    r3 := '0' asInteger.
    _ := (r3 asString) print.
    r4 := '100' asInteger.
    _ := (r4 asString) print.
  ]
}
