+++ BUILTIN
*** String length returns the number of characters in the string
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := '' length.
    _ := (r1 asString) print.
    r2 := 'abc' length.
    _ := (r2 asString) print.
    r3 := 'hello world' length.
    _ := (r3 asString) print.
    r4 := 'a' length.
    _ := (r4 asString) print.
  ]
}
