+++ BUILTIN
*** Boolean and: with short-circuit evaluation
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := true and: [| _ := true. ].
    _ := (r1 asString) print.
    r2 := true and: [| _ := false. ].
    _ := (r2 asString) print.
    r3 := false and: [| _ := true. ].
    _ := (r3 asString) print.
    r4 := false and: [| _ := nil error. ].
    _ := (r4 asString) print.
  ]
}
