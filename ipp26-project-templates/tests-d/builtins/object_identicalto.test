+++ BUILTIN
*** Object identicalTo: checks reference identity
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    a := 'hello'.
    b := a.
    c := 'hello'.
    r1 := a identicalTo: b.
    _ := (r1 asString) print.
    r2 := a identicalTo: c.
    _ := (r2 asString) print.
    r3 := nil identicalTo: nil.
    _ := (r3 asString) print.
    r4 := nil identicalTo: 42.
    _ := (r4 asString) print.
  ]
}
