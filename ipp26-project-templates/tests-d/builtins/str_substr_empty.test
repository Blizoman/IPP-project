+++ BUILTIN
*** String startsWith:endsBefore: when endsBefore <= startsWith returns empty string
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := 'Hello' startsWith: 3 endsBefore: 3.
    _ := (r1 asString) print.
    _ := 'sep' print.
    r2 := 'Hello' startsWith: 4 endsBefore: 2.
    _ := (r2 asString) print.
    _ := 'sep' print.
  ]
}
