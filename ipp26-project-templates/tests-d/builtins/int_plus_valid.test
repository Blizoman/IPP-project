+++ BUILTIN
*** Integer plus: with valid integer arguments
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    r1 := 3 plus: 4.
    _ := (r1 asString) print.
    r2 := 0 plus: 0.
    _ := (r2 asString) print.
    r3 := 100 plus: 200.
    _ := (r3 asString) print.
    r4 := 5 plus: -3.
    _ := (r4 asString) print.
    r5 := -7 plus: -2.
    _ := (r5 asString) print.
  ]
}
