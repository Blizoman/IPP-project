+++ BLOCKS
*** Two closures sharing the same captured variable
!C! 0
!I! 0
>>> 2

class Main : Object {
  run [|
    counter := 0.
    inc := [| counter := counter plus: 1. ].
    dec := [| counter := counter minus: 1. ].
    _ := inc value.
    _ := inc value.
    _ := inc value.
    _ := (counter asString) print.
    _ := dec value.
    _ := (counter asString) print.
    _ := dec value.
    _ := (counter asString) print.
  ]
}
