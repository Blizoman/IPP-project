+++ ERRORS
*** Attribute name colliding with method in same class should fail with error 54
!C! 0
!I! 54
>>> 2

class Foo : Object {
  bar [| _ := 'bar method' print. ]

  doCollide [|
    "Setting attribute 'bar' from within Foo, where 'bar' is a method"
    _ := self bar: 'value'.
  ]
}

class Main : Object {
  run [|
    f := Foo new.
    _ := f doCollide.
  ]
}
