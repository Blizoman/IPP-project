+++ MESSAGE RESPONSE
*** Self: 0-param selector reads instance attribute when no method found
!C! 0
!I! 0
>>> 1

class Foo : Object {
  init [|
    _ := self val: 7.
  ]
  showVal [|
    _ := ((self val) asString) print.
  ]
}

class Main : Object {
  run [|
    f := Foo new.
    _ := f init.
    _ := f showVal.
  ]
}
