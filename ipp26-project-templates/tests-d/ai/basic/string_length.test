+++ BASIC
*** String length method
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    a := 'Hello' length.
    _ := (a asString) print.
    b := '' length.
    _ := (b asString) print.
    c := 'Hello, World!' length.
    _ := (c asString) print.
    d := 'a' length.
    _ := (d asString) print.
  ]
}
