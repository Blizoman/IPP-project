+++ BASIC
*** Boolean not, asString, isBoolean
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    _ := (true asString) print.
    _ := (false asString) print.
    _ := ((true not) asString) print.
    _ := ((false not) asString) print.
    _ := ((true isBoolean) asString) print.
    _ := ((false isBoolean) asString) print.
  ]
}
