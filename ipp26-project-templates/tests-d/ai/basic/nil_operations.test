+++ BASIC
*** Nil operations: asString, isNil, isBoolean, isNumber, isString, isBlock
!C! 0
!I! 0
>>> 1

class Main : Object {
  run [|
    _ := (nil asString) print.
    _ := ((nil isNil) asString) print.
    _ := ((nil isBoolean) asString) print.
    _ := ((nil isNumber) asString) print.
    _ := ((nil isString) asString) print.
    _ := ((nil isBlock) asString) print.
  ]
}
