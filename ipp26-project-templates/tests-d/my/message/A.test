+++ MESSAGE
*** 1.2.11. A Reaction example 
!C! 0
!I! 0
>>> 2

class A : Object {
  foo [| _ := 'foo' print. ]
  bar: [ :x | _ := (x asString) print. ]
}

class Main : Object {
  run [|
    "Bezparametrické selektory"
    o := A new. "vytvoří instanci A"
    _ := o foo. "metoda se najde v třídě A"
    _ := o asString. "metoda se najde v třídě Object"
    "Jednoparametrické selektory"
    _ := o bar: 1. "metoda se najde v třídě A"
    _ := ((o equalTo: 1) asString) print. "metoda se najde v třídě Object"
    _ := (((o goo: 100) goo) asString) print. "metoda 'goo:' se nenajde v A ani v Object, na instanci se vytvoří atribut 'goo'"
  ]
}