+++ OOP
*** Basic class inheritance and method override
!C! 0
!I! 0
>>> 3

class Animal : Object {
    speak [ |
        _ := 'generic sound' print.
    ]
}

class Dog : Animal {
    speak [ |
        _ := 'woof' print.
    ]
}

class Main : Object {
    run [ |
        d := Dog new.
        _ := d speak.
    ]
}