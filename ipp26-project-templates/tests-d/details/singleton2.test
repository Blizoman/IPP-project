*** All are same instance - so they share attributes?
!I! 0
!C! 0
>>> 1

class Main : Object {
  print: [:x | _ := (x asString) print.]

  run [|
    a := nil.
    b := Nil new.
    _ := a foo: 5.

    _ := self print: (a foo).
    _ := self print: (b foo).
    _ := self print: (nil foo).
  ]
}
